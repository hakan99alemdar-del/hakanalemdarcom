---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { studios, totals, stripArt } from '../data/projects';
const k = (n: number) => Math.floor(n / 1000);
const usd = (n: number) => '$' + n.toLocaleString('en-US');
const year = (s?: string) => s?.split(' ').pop();
const partners = ['Kickstarter', 'BackerKit', 'Grim Golem', 'Grimcraft Games', 'OGEM Istanbul'];

// Full-bleed art for each project in the hero; the books without key art use their print photo.
const heroArt: Record<string, string> = {
  odsire: '/art/odsire/ortahisar-dusk.webp',
  yatagan: '/art/yatagan/cover.webp',
  crusades: '/art/crusades/citadel-of-saladin.webp',
  'silk-road': '/art/books/silk-road.webp',
  seekers: '/art/crescent/lunar-eclipse.webp',
  wayfarer: '/art/books/wayfarer.webp',
};
const short: Record<string, string> = { odsire: 'Odsire', yatagan: 'Yatagan', crusades: 'Crusades', 'silk-road': 'Silk Road', seekers: 'Crescent', wayfarer: 'Wayfarer' };
const slides = studios.flatMap((s) => s.projects.map((p) => ({ ...p, studio: s.name })));
const [vv, metis] = studios;
const [odsire, yatagan] = vv.projects;
const wide = new Set([0, 4, 9]);
---
<Base side="games" title="Hakan Alemdar · Producer of tabletop RPGs" description={`Co-founder and producer of tabletop RPGs: ${totals.campaigns} Kickstarter campaigns, $${k(totals.pledged)}K+ raised from ${totals.backers.toLocaleString('en-US')} backers.`}>
  <section class="hero games" id="top">
    <div class="slides" aria-hidden="true">
      {slides.map((p, i) => (
        <div class:list={['slide', { on: i === 0 }]}><img src={heroArt[p.slug]} alt="" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'}></div>
      ))}
    </div>
    <div class="wrap hero-body">
      {slides.map((p, i) => (
        <div class:list={['slide-text', { on: i === 0 }]} id={`slide-${i}`} role="tabpanel">
          <div class="kicker">{p.studio} · {p.platform} · {p.pledged ? `${usd(p.pledged)} raised` : p.status}</div>
          {i === 0
            ? <h1 class="display" transition:name="headline">{short[p.slug]}</h1>
            : <h2 class="display">{short[p.slug]}</h2>}
          <p>{p.blurb}</p>
          <div class="btns">
            <a class="btn" href={p.url}>{p.pledged ? 'See the campaign' : 'Follow the launch'} <Arrow /></a>
            <span class="count">0{i + 1} / 0{slides.length}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="tabs" role="tablist" aria-label="Projects">
      {slides.map((p, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`slide-${i}`}>{p.title.replace('Historica Arcanum: ', '')}</button>
      ))}
    </div>
  </section>

  <section class="sec wrap">
    <div class="stats rv">
      <div><b data-count={k(totals.pledged)} data-pre="$" data-suf="K+">${k(totals.pledged)}K+</b><span>raised on Kickstarter</span></div>
      <div><b data-count={totals.backers}>{totals.backers.toLocaleString('en-US')}</b><span>backers</span></div>
      <div><b data-count={totals.campaigns}>{totals.campaigns}</b><span>funded campaigns, all past goal</span></div>
      <div><b>2</b><span>studios co-founded</span></div>
    </div>
    <p class="src">Totals from the public campaign pages, October 2026.</p>
  </section>

  <section class="sec wrap" id="studios">
    <header class="studio-head rv">
      <h2 class="display">{vv.name}</h2>
      <p>{vv.role} · {vv.years}. {vv.note}</p>
    </header>
    <article class="feature rv">
      <img src="/art/odsire/ruhimancer.webp" alt="Ruhimancer, key art from Odsire" loading="lazy">
      <div class="feature-body">
        <div>
          <span class="kicker">{odsire.platform} · Ended {odsire.ended}</span>
          <h3>{odsire.title}</h3>
          <p>{odsire.blurb}</p>
          <p class="role">{odsire.role}</p>
          <a href={odsire.url}>See the campaign →</a>
        </div>
        <div class="nums">
          <div><b>{usd(odsire.pledged!)}</b><span>{Math.round(odsire.pledged! / odsire.goal!)}× the {usd(odsire.goal!)} goal</span></div>
          <div><b>{odsire.backers}</b><span>backers</span></div>
        </div>
      </div>
    </article>
    <article class="duo rv">
      <img src={yatagan.art.cover} alt={`${yatagan.title} cover art`} loading="lazy">
      <div>
        <span class="kicker">{yatagan.platform} · {yatagan.status}</span>
        <h3>Yatagan</h3>
        <p>{yatagan.blurb}</p>
        <p class="role">{yatagan.role}</p>
        <a href={yatagan.url}>Follow the launch →</a>
      </div>
    </article>
  </section>

  <section class="sec wrap">
    <header class="studio-head rv">
      <h2 class="display">{metis.name}</h2>
      <p>{metis.role} · {metis.years}. {metis.note}</p>
    </header>
    <div class="tiles">
      {metis.projects.map((p) => (
        <a class="tile rv" href={p.url}>
          <span class="ph"><img src={p.art.cover} alt={`${p.title}, printed books`} loading="lazy"></span>
          <span class="meta">{p.ended} · {usd(p.pledged!)} · {p.backers?.toLocaleString('en-US')} backers</span>
          <h3>{p.title.replace('Historica Arcanum: ', '')}</h3>
          <p>{p.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="sec" id="art">
    <div class="wrap sec-head rv"><h2 class="display">From the books</h2><p>Art from Odsire (© Vernal Voyage) and Historica Arcanum (© Metis Creative), shown with permission. Click to enlarge.</p></div>
    <div class="wall">
      {stripArt.map(([slug, title], i) => (
        <button type="button" class:list={{ wide: wide.has(i) }} data-full={`/art/${slug}.webp`} data-title={title} aria-label={`Open ${title}`}>
          <img src={`/art/${slug}${wide.has(i) ? '' : '-sm'}.webp`} alt="" loading="lazy" decoding="async">
          <span>{title}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="sec wrap">
    <ul class="partners rv"><li>Worked with</li>{partners.map((n) => <li>{n}</li>)}</ul>
  </section>

  <section class="sec wrap">
    <a class="bridge cool rv" href="/law">
      <div>
        <span class="kicker">The other side</span>
        <span class="display">My day job: tech law</span>
        <p>Attorney and LL.M. candidate in Digitalization and Law. Data protection, AI regulation, IP licensing and cross-border contracts.</p>
        <span class="go">Law &amp; Tech →</span>
      </div>
    </a>
  </section>

  <section class="wrap contact" id="contact">
    <h2 class="display rv">Let’s make one</h2>
    <div class="btns">
      <a class="btn" href="mailto:hakan99alemdar@gmail.com">hakan99alemdar@gmail.com</a>
      <a class="btn ghost" href="https://www.linkedin.com/in/hakanalemdar">LinkedIn</a>
    </div>
    <footer class="foot">
      <span>Producer · Co-founder · Istanbul &amp; New York</span>
      <span>© 2026 Hakan Alemdar</span>
    </footer>
  </section>

  <dialog class="lightbox" id="lightbox">
    <form method="dialog"><button class="close" aria-label="Close">×</button></form>
    <img alt="" id="lightbox-img">
    <p id="lightbox-title"></p>
  </dialog>
</Base>
