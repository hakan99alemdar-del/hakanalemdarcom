---
import Base from '../layouts/Base.astro';
import LegalCode from '../components/LegalCode.astro';
import Embers from '../components/Embers.astro';
import Arrow from '../components/Arrow.astro';
import { totals } from '../data/projects';
const k = Math.floor(totals.pledged / 1000);
---
<Base side="home" title="Hakan Alemdar · Tech lawyer and games producer" description={`Attorney and LL.M. candidate in Digitalization and Law, and co-founder of two tabletop RPG studios with $${k}K+ raised on Kickstarter.`}>
  <div class="split">
    <a class="half law" href="/law">
      <LegalCode avoid=".half.law .kicker, .half.law .who, .half.law .enter, .badge-name" />
      <span class="kicker">I · Law &amp; Tech</span>
      <span class="who">
        <span class="display">The<br><em>lawyer</em></span>
        <p>Attorney and LL.M. candidate in Digitalization and Law. Data protection, AI Act, IP and licensing.</p>
      </span>
      <span class="enter">Enter <Arrow /></span>
    </a>
    <a class="half games" href="/games">
      <img class="bg" src="/art/odsire/ortahisar-dusk.webp" alt="" fetchpriority="high">
      <span class="shade"></span>
      <Embers />
      <span class="kicker">II · Games</span>
      <span class="who">
        <span class="display">The<br><em>producer</em></span>
        <p>Co-founder of two tabletop RPG studios. ${k}K+ raised from {totals.backers.toLocaleString('en-US')} backers.</p>
      </span>
      <span class="enter">Enter <Arrow /></span>
    </a>
    <a class="home-legal" href="/privacy">Privacy</a>
    <div class="badge-name"><h1>Hakan<br>Alemdar</h1><span>Pick a side</span></div>
  </div>
</Base>
