---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/anton/400.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/site.css';

interface Props { side: 'home' | 'law' | 'games'; title: string; description: string; page?: 'blog' | 'privacy'; image?: string; }
const { side, title, description, page, image } = Astro.props;
const ogImage = new URL(image ?? `/og/${side}.jpg`, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = side === 'games'
  ? [['/games#studios', 'Studios'], ['/games/blog', 'Blog'], ['/games#contact', 'Contact']]
  : [['/law#focus', 'Focus'], ['/law#experience', 'Experience'], ['/law/blog', 'Blog'], ['/law#contact', 'Contact']];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Hakan Alemdar',
  url: Astro.site!.href,
  jobTitle: 'Attorney at the Istanbul Bar; LL.M. candidate in Digitalization and Law',
  email: 'mailto:hakan99alemdar@gmail.com',
  sameAs: ['https://www.linkedin.com/in/hakanalemdar'],
  address: { '@type': 'PostalAddress', addressLocality: 'Frankfurt am Main', addressCountry: 'DE' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Julius-Maximilians-Universität Würzburg' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Kocaeli University' },
  knowsLanguage: ['tr', 'en', 'de'],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="profile">
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content="Hakan Alemdar">
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="sitemap" href="/sitemap-index.xml">
  <meta name="theme-color" content={side === 'games' ? '#0B0907' : '#0A0F1A'}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
  <ClientRouter />
</head>
<body data-side={side}>
  <a class="skip" href="#main">Skip to content</a>
  {side !== 'home' && (
    <header class="top">
      <div class="wrap">
        <a class="name" href="/">HAKAN ALEMDAR</a>
        <nav aria-label="Main">
          {links.map(([href, label]) => <a class:list={['sec-link', { keep: href.endsWith('/blog') }]} href={href} aria-current={page === 'blog' && href.endsWith('/blog') ? 'page' : undefined}>{label}</a>)}
          <span class="sep" aria-hidden="true"></span>
          <a class="side" href="/law" aria-current={!page && side === 'law' ? 'page' : undefined}>Law &amp; Tech</a>
          <a class="side" href="/games" aria-current={!page && side === 'games' ? 'page' : undefined}>Games</a>
        </nav>
      </div>
    </header>
  )}
  <main id="main">
    <slot />
  </main>
</body>
</html>

<script>
  function reveal() {
    const els = document.querySelectorAll<HTMLElement>('.rv');
    if (!('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('in')); return; }
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    els.forEach((e) => io.observe(e));
  }
  function countUp() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const els = document.querySelectorAll<HTMLElement>('[data-count]');
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      io.unobserve(en.target);
      const el = en.target as HTMLElement;
      const end = Number(el.dataset.count), pre = el.dataset.pre ?? '', suf = el.dataset.suf ?? '';
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 1400);
        el.textContent = pre + Math.round(end * (1 - (1 - p) ** 3)).toLocaleString('en-US') + suf;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }));
    els.forEach((e) => io.observe(e));
  }
  let timer: number | undefined;
  function slides() {
    window.clearInterval(timer);
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs button')];
    if (!tabs.length) return;
    const pics = document.querySelectorAll('.slide'), texts = document.querySelectorAll('.slide-text');
    let cur = 0;
    const show = (i: number) => {
      cur = i;
      tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
      pics.forEach((p, k) => p.classList.toggle('on', k === i));
      texts.forEach((p, k) => p.classList.toggle('on', k === i));
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => { window.clearInterval(timer); show(i); }));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      timer = window.setInterval(() => show((cur + 1) % tabs.length), 7000);
    }
  }
  document.addEventListener('astro:page-load', () => { reveal(); countUp(); slides(); });
</script>
