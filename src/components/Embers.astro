---
// Games panel overlay: sparks flying up from an unseen fire, a nod to Odsire's
// pyres. Each spark has a motion-blur tail, rides a turbulent updraft and
// cools from white-gold to deep red before it dies.
---
<canvas class="embers" aria-hidden="true"></canvas>

<script>
  let raf = 0;
  let ro: ResizeObserver | undefined;

  // Soft glow used for every spark head; drawing a sprite is far cheaper than shadowBlur.
  function glowSprite() {
    const c = document.createElement('canvas');
    c.width = c.height = 64;
    const g = c.getContext('2d')!;
    const r = g.createRadialGradient(32, 32, 0, 32, 32, 32);
    r.addColorStop(0, 'rgba(255,255,240,1)');
    r.addColorStop(0.12, 'rgba(255,220,150,.9)');
    r.addColorStop(0.35, 'rgba(255,140,50,.35)');
    r.addColorStop(1, 'rgba(255,80,10,0)');
    g.fillStyle = r;
    g.fillRect(0, 0, 64, 64);
    return c;
  }

  // Colour by temperature: 0 = fresh (white-gold), 1 = cooled (ember red).
  function heat(k: number) {
    if (k < 0.3) { const t = k / 0.3; return [255, 245 - 60 * t, 200 - 120 * t]; }
    const t = (k - 0.3) / 0.7;
    return [255 - 50 * t, 185 - 125 * t, 80 - 60 * t];
  }

  function start() {
    cancelAnimationFrame(raf);
    ro?.disconnect();
    const cv = document.querySelector<HTMLCanvasElement>('.embers');
    if (!cv || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const ctx = cv.getContext('2d')!;
    const sprite = glowSprite();
    let w = 0, h = 0, target = 0;
    type S = { x: number; y: number; vx: number; vy: number; z: number; age: number; life: number; seed: number; trail: number[] };
    let sparks: S[] = [];

    const make = (x = Math.random() * w, y = h + 10 + Math.random() * 30, kick = 1): S => {
      const z = Math.random() ** 1.6; // most sparks far away, a few close
      return {
        x, y, z,
        vx: (Math.random() - 0.5) * 40 * kick,
        vy: -(60 + Math.random() * 120) * (0.5 + z) * kick,
        age: 0,
        life: 1.8 + Math.random() * 3.2,
        seed: Math.random() * 1000,
        trail: [],
      };
    };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = cv.clientWidth; h = cv.clientHeight;
      cv.width = w * dpr; cv.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      target = Math.round(Math.min(140, (w * h) / 6500));
    };

    let last = 0, nextBurst = 1.5, clock = 0, lastSample = 0;
    const step = (now: number) => {
      raf = requestAnimationFrame(step);
      if (stale) { stale = false; resize(); }
      const dt = Math.min(0.04, (now - (last || now)) / 1000);
      last = now;
      clock += dt;
      // Sample tails on a fixed clock so they look the same at any frame rate.
      const sample = clock - lastSample > 0.024;
      if (sample) lastSample = clock;

      // Keep a steady stream, plus the odd crackle: a burst from one point.
      while (sparks.length < target) {
        const s = make();
        s.age = Math.random() * s.life * 0.3;
        s.y = h - Math.random() * h * 0.35;
        sparks.push(s);
      }
      if (clock > nextBurst) {
        const bx = w * (0.15 + Math.random() * 0.7), by = h * (0.75 + Math.random() * 0.2);
        for (let i = 0; i < 10 + Math.random() * 10; i++) sparks.push(make(bx, by, 1.4));
        nextBurst = clock + 2.5 + Math.random() * 4;
      }

      ctx.clearRect(0, 0, w, h);
      // Firelight breathing up from below the frame.
      const flick = 0.11 + 0.03 * Math.sin(clock * 2.1) + 0.02 * Math.sin(clock * 5.3);
      const fl = ctx.createLinearGradient(0, h, 0, h * 0.55);
      fl.addColorStop(0, `rgba(255,110,40,${flick})`);
      fl.addColorStop(1, 'rgba(255,110,40,0)');
      ctx.fillStyle = fl;
      ctx.fillRect(0, h * 0.55, w, h * 0.45);

      ctx.globalCompositeOperation = 'lighter';
      ctx.lineCap = 'round';
      for (let i = sparks.length - 1; i >= 0; i--) {
        const s = sparks[i];
        s.age += dt;
        if (s.age > s.life || s.y < -40 || s.x < -40 || s.x > w + 40) {
          if (sparks.length > target) sparks.splice(i, 1); else sparks[i] = make();
          continue;
        }
        // Turbulent updraft with a light wind to the left.
        const n = Math.sin(s.y * 0.011 + clock * 1.7 + s.seed) + Math.sin(s.x * 0.007 - clock * 1.1 + s.seed * 2) * 0.6;
        s.vx += (n * 90 - 12 - s.vx * 0.6) * dt;
        s.vy += (-25 - s.vy * 0.25) * dt;
        s.x += s.vx * dt * (0.6 + s.z * 0.6);
        s.y += s.vy * dt * (0.6 + s.z * 0.6);
        if (sample) { s.trail.push(s.x, s.y); if (s.trail.length > 12) s.trail.splice(0, 2); }

        const k = s.age / s.life;
        const [r, g, b] = heat(k);
        const flicker = 0.75 + 0.25 * Math.sin(clock * 30 + s.seed);
        const a = Math.min(1, s.age * 6) * (1 - k * k) * flicker;
        const size = 0.6 + s.z * 1.9;

        // Tail: a wide faint stroke for the glow, a thin bright one for the core.
        const t = s.trail;
        if (t.length >= 2) {
          ctx.beginPath();
          ctx.moveTo(t[0], t[1]);
          for (let j = 2; j < t.length; j += 2) ctx.lineTo(t[j], t[j + 1]);
          ctx.lineTo(s.x, s.y);
          ctx.strokeStyle = `rgba(${r},${g * 0.75},${b * 0.5},${a * 0.22})`;
          ctx.lineWidth = size * 3;
          ctx.stroke();
          ctx.strokeStyle = `rgba(${r},${g},${b},${a * 0.8})`;
          ctx.lineWidth = size;
          ctx.stroke();
        }
        const d = size * (7 + 3 * flicker);
        ctx.globalAlpha = a * (0.55 + s.z * 0.45);
        ctx.drawImage(sprite, s.x - d / 2, s.y - d / 2, d, d);
        ctx.globalAlpha = 1;
      }
      ctx.globalCompositeOperation = 'source-over';
    };

    resize();
    // Resizing clears the canvas, so apply it at the start of the next frame.
    let stale = false;
    ro = new ResizeObserver(() => { stale = true; });
    ro.observe(cv);
    new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      last = 0;
      if (e.isIntersecting) raf = requestAnimationFrame(step);
    }).observe(cv);
  }
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => { cancelAnimationFrame(raf); ro?.disconnect(); });
</script>
