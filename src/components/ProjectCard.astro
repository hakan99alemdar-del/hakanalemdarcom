---
import fs from 'node:fs';
import path from 'node:path';
import { studios, type Project } from '../data/projects';

interface Props { p: Project; }
const { p } = Astro.props;
const usd = (n: number) => '$' + n.toLocaleString('en-US');
const coverFile = p.art.cover?.slice(1) ?? ['webp', 'avif', 'jpg', 'png'].map((ext) => `art/${p.slug}/cover.${ext}`)
  .find((f) => fs.existsSync(path.join(process.cwd(), 'public', f)));
const max = Math.max(...studios.flatMap((s) => s.projects).map((x) => x.pledged ?? 0));
const pct = p.pledged && p.goal ? Math.round((p.pledged / p.goal) * 100) : undefined;
---
<article class="proj">
  <figure class:list={['art', { ph: !coverFile, photo: p.art.photo }]} style={`--a1:${p.art.from};--a2:${p.art.to};margin:0`}>
    {coverFile && <img src={`/${coverFile}`} alt={p.art.photo ? `${p.title}, printed hardcover` : `${p.title} cover art`} loading="lazy" decoding="async">}
    <figcaption>{p.art.credit ? `Art: ${p.art.credit}` : coverFile ? '' : 'Art coming soon'}</figcaption>
  </figure>
  <div class="body">
    <h4><a href={p.url}>{p.title}</a></h4>
    <div class="meta">{p.platform}{p.ended && ` · ended ${p.ended}`}</div>
    {p.pledged ? (
      <>
        <div class="fund" aria-hidden="true"><i style={`--w:${Math.min(100, Math.round((p.pledged / max) * 100))}%`}></i></div>
        <div class="meta">{usd(p.pledged)} raised · {p.backers?.toLocaleString('en-US')} backers · {pct}% of goal</div>
      </>
    ) : (
      <span class="badge">{p.status}</span>
    )}
    <p>{p.blurb}</p>
    <p class="role"><b>My role:</b> {p.role}</p>
  </div>
</article>
