---
// Law hero backdrop: streams of code flowing left to right, with the rules
// I work on flaring up between them like neon signs.
const tags = ['GDPR · Art. 28', 'AI Act · Art. 50', 'UrhG · § 31', 'DSA · Art. 14', 'Data Act', 'TDDDG · § 25',
  'BGB · § 327', 'AI Act · Annex III', 'GDPR · Art. 44', 'Licence scope', 'NIS2', 'GDPR · Art. 6'];
---
<canvas class="code-rain" aria-hidden="true" data-tags={JSON.stringify(tags)}></canvas>

<script>
  const GLYPHS = '01{}[]()<>=;:#$%&*+-/|_.abcdef0123456789§ABCDEFxyz';
  const pick = () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
  let raf = 0;
  let onResize: (() => void) | undefined;

  function start() {
    cancelAnimationFrame(raf);
    const cv = document.querySelector<HTMLCanvasElement>('.code-rain');
    if (!cv) return;
    const ctx = cv.getContext('2d')!;
    const tags: string[] = JSON.parse(cv.dataset.tags!);
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CW = 9, RH = 22, MONO = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
    let w = 0, h = 0, cols = 0, rows = 0, limit = 0;
    let grid: string[][] = [];
    let streams: { row: number; head: number; len: number; every: number }[] = [];
    let signs: { row: number; col: number; text: string; t0: number }[] = [];

    const spawn = (row: number, head = -Math.floor(Math.random() * cols)) =>
      ({ row, head, len: 10 + Math.floor(Math.random() * 28), every: 1 + Math.floor(Math.random() * 3) });

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = cv.clientWidth; h = cv.clientHeight;
      cv.width = w * dpr; cv.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(w / CW); rows = Math.ceil(h / RH);
      grid = Array.from({ length: rows }, () => Array.from({ length: cols }, pick));
      streams = [];
      for (let r = 0; r < rows; r++) {
        const n = 2 + Math.floor(Math.random() * 2);
        for (let i = 0; i < n; i++) streams.push(spawn(r, Math.floor(Math.random() * cols * 1.3)));
      }
      // Neon signs only light up in the open space above the headline.
      const kicker = cv.parentElement!.querySelector('.kicker');
      limit = kicker ? kicker.getBoundingClientRect().top - cv.getBoundingClientRect().top - RH : h;
    };

    let tick = 0, last = 0, nextSign = 600;
    const draw = (now: number) => {
      ctx.clearRect(0, 0, w, h);
      ctx.font = `13px ${MONO}`;
      ctx.textBaseline = 'middle';
      for (const s of streams) {
        const y = s.row * RH + RH / 2;
        const dim = y < limit ? 1 : 0.22;
        for (let k = 0; k < s.len; k++) {
          const c = s.head - k;
          if (c < 0 || c >= cols) continue;
          const a = k === 0 ? 0.9 : 0.4 * (1 - k / s.len);
          ctx.fillStyle = k === 0 ? `rgba(220,230,255,${a * dim})` : `rgba(140,170,255,${a * dim})`;
          ctx.fillText(grid[s.row][c], c * CW, y);
        }
      }
      ctx.font = `600 14px ${MONO}`;
      for (const s of signs) {
        const t = now - s.t0;
        // Flicker on, glow, fade out.
        const a = t < 300 ? [0, .7, .2, .9, .5, 1][Math.floor(t / 50)] ?? 1 : t < 1900 ? 1 : Math.max(0, 1 - (t - 1900) / 900);
        const x = s.col * CW, y = s.row * RH + RH / 2;
        const tw = ctx.measureText(s.text).width;
        ctx.fillStyle = `rgba(10,15,26,${0.9 * Math.min(1, a * 2)})`;
        ctx.fillRect(x - 10, y - RH / 2, tw + 20, RH);
        ctx.shadowColor = `rgba(130,120,255,${a})`;
        ctx.shadowBlur = 26;
        ctx.fillStyle = `rgba(205,220,255,${a})`;
        ctx.fillText(s.text, x, y);
        ctx.fillText(s.text, x, y);
        ctx.shadowBlur = 6;
        ctx.fillStyle = `rgba(255,255,255,${a * 0.8})`;
        ctx.fillText(s.text, x, y);
        ctx.shadowBlur = 0;
      }
    };

    const step = (now: number) => {
      raf = requestAnimationFrame(step);
      if (now - last < 33) return;
      last = now;
      if (++tick % 2 === 0) {
        for (const s of streams) {
          if (tick % (s.every * 2) === 0) s.head++;
          if (s.head - s.len > cols) Object.assign(s, spawn(s.row));
        }
        for (let i = 0; i < 40; i++) grid[Math.floor(Math.random() * rows)][Math.floor(Math.random() * cols)] = pick();
      }
      signs = signs.filter((s) => now - s.t0 < 2800);
      if (now > nextSign && signs.length < 2) {
        const free = Math.floor(limit / RH);
        const text = tags[Math.floor(Math.random() * tags.length)].toUpperCase();
        if (free > 0) {
          const row = Math.floor(Math.random() * free);
          if (!signs.some((s) => Math.abs(s.row - row) < 2)) {
            const col = Math.floor(Math.random() * Math.max(1, cols - text.length - 4)) + 2;
            signs.push({ row, col, text, t0: now });
          }
        }
        nextSign = now + 900 + Math.random() * 900;
      }
      draw(now);
    };

    resize();
    if (still) {
      signs = [{ row: 1, col: Math.floor(cols * 0.55), text: tags[0].toUpperCase(), t0: -1000 }];
      draw(0);
      return;
    }
    new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      if (e.isIntersecting) raf = requestAnimationFrame(step);
    }).observe(cv);
    let rt: number | undefined;
    if (onResize) removeEventListener('resize', onResize);
    onResize = () => { clearTimeout(rt); rt = window.setTimeout(resize, 200); };
    addEventListener('resize', onResize);
  }
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf));
</script>
