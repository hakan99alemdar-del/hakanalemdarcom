---
import type { Project } from '../data/projects';

interface Props { p: Project; }
const { p } = Astro.props;
const usd = (n: number) => '$' + n.toLocaleString('en-US');
const pct = p.pledged && p.goal ? Math.round((p.pledged / p.goal) * 100) : undefined;
---
<article class="show">
  <figure class:list={['show-media', { ph: !p.art.cover, photo: p.art.photo }]} style={`--a1:${p.art.from};--a2:${p.art.to}`}>
    {p.art.cover
      ? <img src={p.art.cover} alt={p.art.photo ? `${p.title}, printed hardcover` : `${p.title} cover art`} loading="lazy" decoding="async">
      : <figcaption>Art coming soon</figcaption>}
  </figure>
  <div class="show-text">
    <div class="eyebrow">{p.platform}{p.ended && ` · ${p.ended}`}</div>
    <h4>{p.title}</h4>
    <p class="show-blurb">{p.blurb}</p>
    {p.pledged ? (
      <dl class="show-stats">
        <div><dt>Raised</dt><dd>{usd(p.pledged)}</dd></div>
        <div><dt>Backers</dt><dd>{p.backers?.toLocaleString('en-US')}</dd></div>
        <div><dt>Of goal</dt><dd>{pct}%</dd></div>
      </dl>
    ) : (
      <span class="badge">{p.status}</span>
    )}
    <p class="role"><b>My role:</b> {p.role}</p>
    <a class="cta" href={p.url}>{p.pledged ? 'See the campaign' : 'Follow the launch'} <span aria-hidden="true">→</span></a>
  </div>
</article>
