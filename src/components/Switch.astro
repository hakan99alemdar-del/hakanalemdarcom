---
interface Props { side: 'law' | 'games'; }
const { side } = Astro.props;
const games = side === 'games';
---
<a class="switch" href={games ? '/' : '/games'} aria-label={games ? 'Switch to law and tech' : 'Switch to games career'}>
  <span class:list={['lbl', { on: !games }]}>Law &amp; Tech</span>
  <span class="track" aria-hidden="true" transition:name="switch"><span class="knob">{games ? '✦' : '§'}</span></span>
  <span class:list={['lbl', { on: games }]}>Games</span>
</a>
